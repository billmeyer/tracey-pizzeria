# Copy this file to .env and fill in real values before starting anything.
#
# The Makefile loads this file with `-include .env`, so all five `make run-*`
# targets see these values in every terminal. Nothing else reads it.
#
# Values must not contain a `#` character — make would treat it as a comment.

# AWS Bedrock — the backend calls Claude Haiku through Bedrock, not through
# Anthropic's own API, so there is no ANTHROPIC_API_KEY in this stack.
#
# In the Instruqt lab these are already present in the VM environment; this
# block is for running the stack anywhere else.
#
# Region is required — the Bedrock client has no default.
AWS_REGION=us-east-1

# OPTIONAL. Overrides the model id hardcoded in backend/src/claude.ts, which
# already defaults to the value below — leave this unset unless you are
# repointing at a different model.
#
# Note it is NOT the first-party model id: Bedrock adds a provider prefix and a
# version suffix, and the leading `us.` selects a cross-region inference
# profile. The first-party `claude-haiku-4-5-20251001` will 404.
#BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock API key, sent by the client as a bearer token. This is the only
# credential the stack uses.
#
# It is presigned and time-limited: once it expires Bedrock answers 403 and the
# chat endpoint 500s. If chat starts failing partway through a session, mint a
# fresh token before debugging anything else.
AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-your-token-here

# Datadog org that will receive traces/metrics/logs from the OTel Collector
DD_API_KEY=your-datadog-api-key-here
DD_SITE=datadoghq.com

# RUM application ID (Datadog RUM app UUID) sent as datadog.application.id
# on every browser OTel event. Mandatory for RUM data retention -- see
# frontend/src/rum/otel-rum.ts.
DD_RUM_APPLICATION_ID=YOUR_RUM_APPLICATION_ID
